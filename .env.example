# URL base da API do SICIM (módulo BCM) consumida pela SPA
VITE_API_BASE_URL=http://localhost:8080/api/v1/sicim

# Keycloak (realm bcm-sdk, client público bcm-sdk-public, Authorization Code + PKCE)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=bcm-sdk
VITE_KEYCLOAK_CLIENT_ID=bcm-sdk-public
